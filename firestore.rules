rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email is string;
    }
    function email() {
      return request.auth.token.email;
    }
    function principal() {
      return logado() && email() == 'matheusslvdsz@gmail.com';
    }
    function caminhoCadastro() {
      return /databases/$(database)/documents/usuariosSistema/$(email());
    }
    function temCadastro() {
      return logado() && exists(caminhoCadastro());
    }
    function cadastro() {
      return get(caminhoCadastro()).data;
    }
    function perfilValido() {
      return temCadastro() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao', 'consulta'];
    }
    function ativo() {
      return principal() || (perfilValido() && cadastro().ativo == true);
    }
    function perfil(nome) {
      return principal() || (ativo() && cadastro().perfil == nome);
    }
    function admin() { return principal() || perfil('admin'); }
    function financeiro() { return admin() || perfil('financeiro'); }
    function corretor() { return admin() || perfil('corretor'); }
    function manutencao() { return admin() || perfil('manutencao'); }
    function consulta() { return admin() || perfil('consulta'); }
    function equipeOperacional() {
      return principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao', 'consulta']);
    }

    match /usuariosSistema/{usuarioEmail} {
      allow read: if admin() || (logado() && email() == usuarioEmail);
      allow create, update, delete: if admin();
    }

    match /vitrineImoveis/{imovelId} {
      allow read: if true;
      allow create, update, delete: if admin();
      match /fotos/{fotoId} {
        allow read: if true;
        allow create, update, delete: if admin();
      }
    }
    match /vitrineConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /vitrineContatos/{contatoId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'telefone'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 2
                    && request.resource.data.nome.size() <= 120
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.size() >= 8
                    && request.resource.data.telefone.size() <= 30;
      allow read, update, delete: if admin();
    }

    match /imoveis/{imovelId} {
      allow read: if equipeOperacional();
      allow create, delete: if admin();
      allow update: if admin() || (corretor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','atualizadoEm','atualizadoPor','origemAtualizacao']) && request.resource.data.status in ['disponivel','alugado','venda']);
      match /fotos/{fotoId} {
        allow read: if equipeOperacional();
        allow create, update, delete: if admin() || manutencao();
      }
    }
    match /proprietarios/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /inquilinos/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /contratos/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /historicoContratos/{id} {
      allow read: if admin() || financeiro() || consulta();
      allow create, update: if admin() || financeiro();
      allow delete: if admin();
    }
    match /auditoriaSistema/{id} {
      allow read, create, update: if admin();
      allow delete: if false;
    }

    match /financeiro/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /fechamentos/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /boletinsEspeciais/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /bolProprietarios/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /bolImoveis/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }

    match /leads/{id} {
      allow read, create, update: if corretor();
      allow delete: if admin();
    }
    match /eventos/{id} {
      allow read, create, update: if corretor() || financeiro();
      allow delete: if admin();
    }

    match /manutencoes/{id} {
      allow read: if admin() || manutencao() || financeiro() || consulta();
      allow create, update: if admin() || manutencao();
      allow delete: if admin();
    }

    match /corretores/{uid} {
      allow read: if admin() || (corretor() && request.auth.uid == uid);
      allow create, update: if admin() || (corretor() && request.auth.uid == uid);
      allow delete: if admin();
    }
    match /imoveisCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /leadsCorretores/{id} {
      allow read, create, update: if corretor();
      allow delete: if admin();
    }
    match /tarefasCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create: if admin() || (corretor() && request.resource.data.corretorId == request.auth.uid);
      allow update: if admin() || (corretor()
                    && resource.data.corretorId == request.auth.uid
                    && request.resource.data.corretorId == request.auth.uid);
      allow delete: if admin();
    }
    match /negociosCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create: if admin() || (corretor() && request.resource.data.corretorId == request.auth.uid);
      allow update: if admin() || (corretor()
                    && resource.data.corretorId == request.auth.uid
                    && request.resource.data.corretorId == request.auth.uid);
      allow delete: if admin();
    }
    match /boletinsCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /historicoCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.uid == request.auth.uid);
      allow create: if corretor() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }


    // INSPECOES DE IMOVEIS - todos os perfis ativos leem; consulta e somente leitura
    match /inspecoes/{id} {
      allow read: if equipeOperacional();
      allow create, update, delete: if principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao']);
    }
    match /inspecaoImoveis/{id} {
      allow read: if equipeOperacional();
      allow create, update, delete: if principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
