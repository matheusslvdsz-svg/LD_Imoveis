rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email is string;
    }
    function email() {
      return request.auth.token.email;
    }
    function principal() {
      return logado() && email() == 'matheusslvdsz@gmail.com';
    }
    function caminhoCadastro() {
      return /databases/$(database)/documents/usuariosSistema/$(email());
    }
    function temCadastro() {
      return logado() && exists(caminhoCadastro());
    }
    function cadastro() {
      return get(caminhoCadastro()).data;
    }
    function perfilValido() {
      return temCadastro() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao', 'consulta'];
    }
    function ativo() {
      return principal() || (perfilValido() && cadastro().ativo == true);
    }
    function perfil(nome) {
      return principal() || (ativo() && cadastro().perfil == nome);
    }
    function admin() { return principal() || perfil('admin'); }
    function financeiro() { return admin() || perfil('financeiro'); }
    function corretor() { return admin() || perfil('corretor'); }
    function manutencao() { return admin() || perfil('manutencao'); }
    function consulta() { return admin() || perfil('consulta'); }
    function equipeOperacional() {
      return principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao', 'consulta']);
    }
    function editorDocumental() {
      return principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao']);
    }

    match /usuariosSistema/{usuarioEmail} {
      allow read: if admin() || (logado() && email() == usuarioEmail);
      allow create, update, delete: if admin();
    }


    // Vitrine v2: somente a projeção sanitizada e explicitamente publicada é pública.
    match /vitrinePublica/{imovelId} {
      allow read: if admin() || resource.data.publicado == true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly([
          'codigo','titulo','tipo','finalidade','valor','condominio','iptu',
          'bairro','cidade','enderecoPublico','exibirEnderecoCompleto',
          'area','quartos','suites','banheiros','vagas','andar','mobilia',
          'descricaoPublica','destaque','ordemVitrine','fotoCapaMini','numFotos',
          'publicado','atualizadoEm'
        ])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.codigo.size() <= 80
        && request.resource.data.publicado is bool
        && request.resource.data.exibirEnderecoCompleto is bool
        && request.resource.data.bairro is string
        && request.resource.data.bairro.size() <= 120
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() <= 120
        && request.resource.data.enderecoPublico is string
        && request.resource.data.enderecoPublico.size() <= 220;
      allow delete: if admin();

      match /fotos/{fotoId} {
        allow read: if admin() || get(/databases/$(database)/documents/vitrinePublica/$(imovelId)).data.publicado == true;
        allow create, update, delete: if admin();
      }
    }

    match /vitrineImoveis/{imovelId} {
      allow read: if true;
      allow create, update, delete: if admin();
      match /fotos/{fotoId} {
        allow read: if true;
        allow create, update, delete: if admin();
      }
    }
    match /vitrineConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /vitrineContatos/{contatoId} {
      allow create: if request.resource.data.keys().hasOnly([
                      'nome','telefone','mensagem','imovelId','imovelCodigo',
                      'imovelTipo','criadoEm','lido'
                    ])
                    && request.resource.data.keys().hasAll(['nome','telefone','criadoEm','lido'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 2
                    && request.resource.data.nome.size() <= 120
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.size() >= 8
                    && request.resource.data.telefone.size() <= 30
                    && (!('mensagem' in request.resource.data)
                        || (request.resource.data.mensagem is string
                            && request.resource.data.mensagem.size() <= 1200))
                    && (!('imovelId' in request.resource.data)
                        || (request.resource.data.imovelId is string
                            && request.resource.data.imovelId.size() <= 160))
                    && (!('imovelCodigo' in request.resource.data)
                        || (request.resource.data.imovelCodigo is string
                            && request.resource.data.imovelCodigo.size() <= 80))
                    && (!('imovelTipo' in request.resource.data)
                        || (request.resource.data.imovelTipo is string
                            && request.resource.data.imovelTipo.size() <= 80))
                    && request.resource.data.criadoEm is string
                    && request.resource.data.criadoEm.size() <= 40
                    && request.resource.data.lido == false;
      allow read, update, delete: if admin();
    }

    match /imoveis/{imovelId} {
      allow read: if equipeOperacional();
      allow create, delete: if admin();
      allow update: if admin() || (corretor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','atualizadoEm','atualizadoPor','origemAtualizacao']) && request.resource.data.status in ['disponivel','alugado','venda']);
      match /fotos/{fotoId} {
        allow read: if equipeOperacional();
        allow create, update, delete: if admin() || manutencao();
      }
    }
    match /proprietarios/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /inquilinos/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /contratos/{id} {
      allow read: if admin() || financeiro() || corretor() || manutencao() || consulta();
      allow create, update, delete: if admin() || financeiro();
    }
    match /historicoContratos/{id} {
      allow read: if admin() || financeiro() || consulta();
      allow create, update: if admin() || financeiro();
      allow delete: if admin();
    }
    match /documentosContadores/{id} {
      allow read: if equipeOperacional();
      allow create: if editorDocumental()
                    && request.resource.data.ultimo == 1
                    && request.resource.data.atualizadoPor == email();
      allow update: if editorDocumental()
                    && request.resource.data.ultimo == resource.data.ultimo + 1
                    && request.resource.data.atualizadoPor == email();
      allow delete: if false;
    }
    match /documentosOficiais/{codigo} {
      allow read: if equipeOperacional();

      // Reserva: qualquer editor documental ativo pode criar somente rascunho próprio.
      allow create: if editorDocumental()
                    && request.resource.data.codigo == codigo
                    && request.resource.data.criadoPor == email()
                    && request.resource.data.status == 'rascunho';

      // Primeira emissão: preserva identidade e só permite rascunho -> emitido.
      allow update: if editorDocumental()
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && resource.data.status == 'rascunho'
                    && request.resource.data.status == 'emitido'
                    && request.resource.data.emitidoPor == email()
                    && request.resource.data.emitidoEm is string;

      // Cancelamento de rascunho ou emitido: exclusivamente administrador e com motivo.
      allow update: if admin()
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && resource.data.status in ['rascunho','emitido']
                    && request.resource.data.status == 'cancelado'
                    && request.resource.data.canceladoPor == email()
                    && request.resource.data.canceladoEm is string
                    && request.resource.data.motivoCancelamento is string
                    && request.resource.data.motivoCancelamento.size() >= 5;

      // Substituição: original fica terminal e aponta para um novo código.
      allow update: if admin()
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && resource.data.status in ['rascunho','emitido']
                    && request.resource.data.status == 'substituido'
                    && request.resource.data.substituidoPorCodigo is string
                    && request.resource.data.substituidoPorCodigo.size() > 0
                    && request.resource.data.substituidoPor == email()
                    && request.resource.data.substituidoEm is string
                    && request.resource.data.motivoSubstituicao is string
                    && request.resource.data.motivoSubstituicao.size() >= 5;

      // Documento oficial nunca é apagado nem reativado após estado terminal.
      allow delete: if false;
    }
    match /auditoriaSistema/{id} {
      allow read: if admin();
      allow create: if ativo()
                    && request.resource.data.usuario == email()
                    && request.resource.data.criadoEm is string;
      allow update: if admin();
      allow delete: if false;
    }

    match /financeiro/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /fechamentos/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /boletinsEspeciais/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /bolProprietarios/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }
    match /bolImoveis/{id} {
      allow read, create, update: if financeiro();
      allow delete: if admin();
    }

    match /leads/{id} {
      allow read, create, update: if corretor();
      allow delete: if admin();
    }
    match /eventos/{id} {
      allow read, create, update: if corretor() || financeiro();
      allow delete: if admin();
    }

    match /manutencoes/{id} {
      allow read: if admin() || manutencao() || financeiro() || consulta();
      allow create, update: if admin() || manutencao();
      allow delete: if admin();
    }

    match /corretores/{uid} {
      allow read: if admin() || (corretor() && request.auth.uid == uid);
      allow create, update: if admin() || (corretor() && request.auth.uid == uid);
      allow delete: if admin();
    }
    match /imoveisCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /leadsCorretores/{id} {
      allow read, create, update: if corretor();
      allow delete: if admin();
    }
    match /tarefasCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create: if admin() || (corretor() && request.resource.data.corretorId == request.auth.uid);
      allow update: if admin() || (corretor()
                    && resource.data.corretorId == request.auth.uid
                    && request.resource.data.corretorId == request.auth.uid);
      allow delete: if admin();
    }
    match /negociosCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create: if admin() || (corretor() && request.resource.data.corretorId == request.auth.uid);
      allow update: if admin() || (corretor()
                    && resource.data.corretorId == request.auth.uid
                    && request.resource.data.corretorId == request.auth.uid);
      allow delete: if admin();
    }
    match /boletinsCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.corretorId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /historicoCorretores/{id} {
      allow read: if admin() || (corretor() && resource.data.uid == request.auth.uid);
      allow create: if corretor() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }


    // INSPECOES DE IMOVEIS - todos os perfis ativos leem; consulta e somente leitura
    match /inspecoes/{id} {
      allow read: if equipeOperacional();
      allow create, update: if principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao']);
      // Laudo com código oficial é histórico permanente; somente rascunho sem código pode ser removido.
      allow delete: if admin()
                    && (!('documentoCodigo' in resource.data) || resource.data.documentoCodigo == '');
    }
    match /inspecaoImoveis/{id} {
      allow read: if equipeOperacional();
      allow create, update: if principal() || (ativo() && cadastro().perfil in ['admin', 'financeiro', 'corretor', 'manutencao']);
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
